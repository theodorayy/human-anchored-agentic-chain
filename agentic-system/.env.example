APP_URL=http://localhost:3003
HAC_DATA_DIR=.hac
OIDC_ISSUER=http://localhost:3006
OIDC_CLIENT_ID=hac-agentic-system
# Generated locally by pnpm setup:local. Never commit a real private key.
OIDC_CLIENT_PRIVATE_JWK=
OPENAI_API_KEY=
BROWSER_TARGET_URL=https://clearance-review-demo.vercel.app
# Optional, several websites: Name=https://site,Name=https://site (first is the default)
BROWSER_TARGETS=
# Only enable for isolated local testing without an IdP. Default sign-in is FreeID.
HAC_DEMO=false

# Required on Vercel: an independent random 32-byte hex cookie-encryption key.
HAC_SESSION_SECRET=
